<Project>
  <PropertyGroup Label="Repository">
    <KhaosRoot>$(MSBuildThisFileDirectory)</KhaosRoot>
  </PropertyGroup>

  <PropertyGroup Label="Configure .csproj">
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>preview-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>false</IsPackable>

    <ArtifactsPath>$(KhaosRoot)artifacts</ArtifactsPath>
    <AssemblyName>KappaDuck.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>

    <!-- Experimental feature: https://github.com/dotnet/core/blob/main/release-notes/11.0/preview/preview1/runtime.md#runtime-async -->
    <Features>$(Features);runtime-async=on</Features>

    <!-- Experimental feature: https://github.com/dotnet/core/blob/main/release-notes/11.0/preview/rc1/csharp.md#unsafe-evolution-refinements -->
    <Features Condition="'$(FileBasedProgram)' != 'true'">$(Features);updated-memory-safety-rules</Features>

    <!-- Configure packages which are only Development dependency -->
    <!-- https://github.com/NuGet/Home/wiki/DevelopmentDependency-support-for-PackageReference -->
    <DevAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</DevAssets>
  </PropertyGroup>

  <ItemGroup Label="Configure analyzer rules">
    <GlobalAnalyzerConfigFiles Include="$(KhaosRoot)rules/*.editorconfig" />
  </ItemGroup>

  <PropertyGroup Label="Games: kind of project" Condition="'$(IsKhaosGame)' == 'true'">
    <IsKhaosDesktop>$(MSBuildProjectName.EndsWith('.Desktop'))</IsKhaosDesktop>
    <!-- A file-based app (dotnet <file>.cs) is named after its file and runs on the desktop. -->
    <IsKhaosDesktop Condition="'$(FileBasedProgram)' == 'true'">true</IsKhaosDesktop>
    <IsKhaosWeb>$(MSBuildProjectName.EndsWith('.Web'))</IsKhaosWeb>

    <!-- A game's assembly is named after the game, not KappaDuck.<project>. -->
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName.Replace('.Desktop', '').Replace('.Web', ''))</RootNamespace>
  </PropertyGroup>

  <!-- What the template writes in each app's project file. -->
  <PropertyGroup Label="Games: Desktop and Web" Condition="'$(IsKhaosDesktop)' == 'true' or '$(IsKhaosWeb)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Label="Games: Desktop" Condition="'$(IsKhaosDesktop)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="$(KhaosRoot)src/Khaos/buildTransitive/KappaDuck.Khaos.props" Condition="'$(IsKhaosGame)' == 'true'" />
</Project>
