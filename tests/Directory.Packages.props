<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TUnitVersion>1.80.0</TUnitVersion>
  </PropertyGroup>
  <ItemGroup Label="Test packages">
    <PackageVersion Include="Basic.Reference.Assemblies.Net110" Version="1.8.14" />
    <PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Mocks.Assertions" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Mocks.Logging" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Assertions.Should" Version="$(TUnitVersion)-beta" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
  </ItemGroup>
</Project>
