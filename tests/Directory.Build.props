<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Configure test projects">
    <OutputType>Exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Experimental feature: https://github.com/dotnet/core/blob/main/release-notes/11.0/preview/preview1/runtime.md#runtime-async
    Only the tests use it on .NET 11: some keep a ref struct across an await, which only runtime async allows. Tests run
    on CoreCLR, never in the browser, where Mono cannot run runtime-async methods (https://github.com/dotnet/runtime/issues/109632).
  -->
  <PropertyGroup Label="Runtime async">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup Label="Common test NuGets">
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.Mocks" />
    <PackageReference Include="TUnit.Mocks.Assertions" />
    <PackageReference Include="TUnit.Mocks.Logging" />
    <PackageReference Include="TUnit.Assertions.Should" />
  </ItemGroup>

  <!--
    Verify (v33+) runs SponsorCheck at build time and fails with SC021 without a declaration.
    Khaos is a non-revenue open source project, which the Verify maintenance fee exempts:
    https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
    The end month is capped at 12 months ahead: renew it before it expires (SC047).
  -->
  <PropertyGroup Label="Verify sponsorship exemption">
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <PropertyGroup Label="Analyzer test projects">
    <IsKhaosAnalyzerTests>$(MSBuildProjectName.EndsWith('.Analyzers.Tests'))</IsKhaosAnalyzerTests>
  </PropertyGroup>

  <PropertyGroup Label="Engine test projects">
    <IsKhaosEngineTests>false</IsKhaosEngineTests>
    <IsKhaosEngineTests Condition="'$(MSBuildProjectName)' == 'Khaos.Tests' or '$(MSBuildProjectName)' == 'Khaos.Allocations.Tests'">true</IsKhaosEngineTests>
  </PropertyGroup>

  <PropertyGroup Label="Engine test projects: native interop in the helpers" Condition="'$(IsKhaosEngineTests)' == 'true'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    SafeDirectories covers the application directory on Windows only. NativeAOT searches the application directory
    on Linux only with AssemblyDirectory, so the native libraries next to the tests are found on both.
    https://learn.microsoft.com/dotnet/api/system.runtime.interopservices.dllimportsearchpath
  -->
  <ItemGroup Label="Engine test projects: default search paths for DLL import" Condition="'$(IsKhaosEngineTests)' == 'true'">
    <AssemblyAttribute Include="System.Runtime.InteropServices.DefaultDllImportSearchPathsAttribute">
      <_Parameter1>System.Runtime.InteropServices.DllImportSearchPath.AssemblyDirectory | System.Runtime.InteropServices.DllImportSearchPath.SafeDirectories</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Label="Engine test helpers" Condition="'$(IsKhaosEngineTests)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Engine/**/*.cs" LinkBase="Engine" />
    <Using Include="KappaDuck.Khaos.Testing.Engine" />
  </ItemGroup>

  <ItemGroup Label="Exclude Test projects from code coverage">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

  <ItemGroup Label="Analyzer test NuGets" Condition="'$(IsKhaosAnalyzerTests)' == 'true'">
    <PackageReference Include="Basic.Reference.Assemblies.Net110" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <ItemGroup Label="Analyzer test harness" Condition="'$(IsKhaosAnalyzerTests)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Harness/**/*.cs" LinkBase="Harness" />
    <Using Include="KappaDuck.Khaos.Testing.Harness" />
  </ItemGroup>

  <ItemGroup Label="Global usings">
    <Using Include="TUnit" />
    <Using Include="TUnit.Mocks" />
    <Using Include="TUnit.Mocks.Assertions" />
    <Using Include="TUnit.Assertions" />
    <Using Include="TUnit.Assertions.Should" />
    <Using Include="TUnit.Assertions.Should.Extensions" />
    <Using Include="TUnit.Core" />
  </ItemGroup>
</Project>
