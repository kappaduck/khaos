<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Assembly">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="Configure default search paths for DLL import">
    <AssemblyAttribute Include="System.Runtime.InteropServices.DefaultDllImportSearchPathsAttribute">
      <_Parameter1>SafeDirectories</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(KhaosRoot)src/Khaos/Khaos.csproj" />
  </ItemGroup>
</Project>
