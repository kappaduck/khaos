<Project>
  <ItemGroup Label="Global usings" Condition="('$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true') and '$(KhaosImplicitUsings)' != 'false'">
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!--
    Environments, like every .NET app: Development, Staging, Production, or any name the game uses.
    The game reads the active one from IHostEnvironment. At runtime the "environment" switch of the
    command line (or of the page's query string), KHAOS_ENVIRONMENT and DOTNET_ENVIRONMENT (what
    launch profiles set) win over these defaults.

      KhaosEnvironment   The environment when nothing else names one. Default: Development in a
                         Debug build, Production otherwise (dotnet publish is Release).
      KhaosDiagnostics   The in-game tools (overlay, time control, console) in the build.
                         Default: true unless KhaosEnvironment is Production, where the trimmer
                         removes them from what players download.

    Both go through the runtime configuration (runtimeconfig.json on the desktop, the boot config
    in the browser): launch profiles cannot reach the .NET runtime inside a page, a build can.
  -->
  <PropertyGroup Label="Environment">
    <KhaosEnvironment Condition="'$(KhaosEnvironment)' == '' and '$(Configuration)' == 'Debug'">Development</KhaosEnvironment>
    <KhaosEnvironment Condition="'$(KhaosEnvironment)' == ''">Production</KhaosEnvironment>

    <KhaosDiagnostics Condition="'$(KhaosDiagnostics)' == '' and '$(KhaosEnvironment)' == 'Production'">false</KhaosDiagnostics>
    <KhaosDiagnostics Condition="'$(KhaosDiagnostics)' == ''">true</KhaosDiagnostics>
  </PropertyGroup>

  <ItemGroup Label="Environment" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Environment" Value="$(KhaosEnvironment)" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Diagnostics.IsSupported" Value="$(KhaosDiagnostics)" Trim="true" />
  </ItemGroup>

  <PropertyGroup>
    <_KhaosAssetsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(KhaosAssetsDirectory)'))</_KhaosAssetsDirectory>
  </PropertyGroup>

  <ItemGroup Label="Assets" Condition="Exists('$(_KhaosAssetsDirectory)')">
    <KhaosAsset Include="$(_KhaosAssetsDirectory)**/*" Exclude="$(_KhaosAssetsDirectory)**/.*" KhaosRelativePath="%(RecursiveDir)%(Filename)%(Extension)"
                KhaosPagePath="assets/%(RecursiveDir)%(Filename)%(Extension)" KhaosPageRoot="$(_KhaosAssetsDirectory)" />
    <None Remove="@(KhaosAsset)" />
    <Content Include="@(KhaosAsset)" Link="assets/%(KhaosRelativePath)" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(UsingMicrosoftNETSdkWebAssembly)' != 'true'" />

    <AdditionalFiles Include="@(KhaosAsset)" Link="assets/%(KhaosRelativePath)" />
  </ItemGroup>

  <!--
    What [AssetCatalog] reads, without a path in the attribute: KhaosRelativePath marks an additional file as an
    asset and gives its path under assets/, which is where the game loads it from whatever KhaosAssetsDirectory
    says. The generator reads build_metadata.AdditionalFiles.KhaosRelativePath.
  -->
  <ItemGroup Label="Asset catalog">
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="KhaosRelativePath" />
  </ItemGroup>

  <ItemGroup Label="Hot reload" Condition="'$(Configuration)' == 'Debug' and Exists('$(_KhaosAssetsDirectory)')">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KhaosAssetsSource</_Parameter1>
      <_Parameter2>$(_KhaosAssetsDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Label="Settings">
    <KhaosSettingsFile Include="$(MSBuildProjectDirectory)/appsettings*.json"
                       KhaosPagePath="%(Filename)%(Extension)" KhaosPageRoot="$(MSBuildProjectDirectory)/" />
    <None Remove="@(KhaosSettingsFile)" />
    <Content Remove="@(KhaosSettingsFile)" />
    <Content Include="@(KhaosSettingsFile)" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(UsingMicrosoftNETSdkWebAssembly)' != 'true'" />
  </ItemGroup>

  <Target Name="GetKhaosPageFiles" Returns="@(KhaosAsset);@(KhaosSettingsFile)" />

  <PropertyGroup Label="Game name" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <KhaosGameName Condition="'$(KhaosGameName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '\.(Desktop|Web)$', ''))</KhaosGameName>
  </PropertyGroup>

  <!--
    The game's identity, which the system shows apart from the window (the volume mixer, the window grouping of a
    Linux desktop). It comes from the usual .NET properties:

      Product               The name. The window title too, when the game gives none.
      Version               The version.
      Company               The creator (Authors when Company is not set).
      Copyright             One line, such as "Copyright (c) 2027 KappaDuck".
      KhaosGameIdentifier   A reverse-domain name, such as com.kappaduck.duckquest.
      KhaosGameUrl          The game's page: a store, itch.io or a repository.

    The SDK fills Product, Authors and Company with the assembly name when the game sets none
    (Microsoft.NET.DefaultAssemblyInfo.targets): the name is then KhaosGameName, and the creator is left out.
    The values go through the runtime configuration, like the environment, and the settings never change them.
  -->
  <PropertyGroup Label="Game metadata" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <_KhaosGameTitle>$(Product)</_KhaosGameTitle>
    <_KhaosGameTitle Condition="'$(Product)' == '' or '$(Product)' == '$(AssemblyName)'">$(KhaosGameName)</_KhaosGameTitle>
    <_KhaosGameCreator Condition="'$(Company)' != '$(AssemblyName)'">$(Company)</_KhaosGameCreator>
  </PropertyGroup>

  <ItemGroup Label="Game metadata" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Name" Value="$(_KhaosGameTitle)" Condition="'$(_KhaosGameTitle)' != ''" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Version" Value="$(Version)" Condition="'$(Version)' != ''" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Creator" Value="$(_KhaosGameCreator)" Condition="'$(_KhaosGameCreator)' != ''" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Copyright" Value="$(Copyright)" Condition="'$(Copyright)' != ''" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Identifier" Value="$(KhaosGameIdentifier)" Condition="'$(KhaosGameIdentifier)' != ''" />
    <RuntimeHostConfigurationOption Include="KappaDuck.Khaos.Game.Url" Value="$(KhaosGameUrl)" Condition="'$(KhaosGameUrl)' != ''" />
  </ItemGroup>

  <Target Name="KhaosRenamePublishedExecutable" AfterTargets="Publish"
            Condition="'$(UsingMicrosoftNETSdkWebAssembly)' != 'true' and '$(KhaosGameName)' != '' and '$(KhaosGameName)' != '$(TargetName)'">
    <PropertyGroup>
      <_KhaosPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_KhaosPublishDir>
      <_KhaosPublishedExecutable>$(_KhaosPublishDir)$(TargetName)$(_NativeExecutableExtension)</_KhaosPublishedExecutable>
    </PropertyGroup>

    <ItemGroup>
      <_KhaosPublishedBinary Include="$(_KhaosPublishedExecutable)" Condition="Exists('$(_KhaosPublishedExecutable)')" />
      <_KhaosPublishedBinary Include="$(_KhaosPublishDir)$(TargetName)*.pdb;$(_KhaosPublishDir)$(TargetName)*.dbg" Condition="'$(PublishAot)' == 'true'" />
      <_KhaosPublishedBinary KhaosRenamed="$(_KhaosPublishDir)$(KhaosGameName)$([System.String]::Copy('%(Filename)%(Extension)').Substring($(TargetName.Length)))" />
    </ItemGroup>

    <Move SourceFiles="@(_KhaosPublishedBinary)" DestinationFiles="@(_KhaosPublishedBinary->'%(KhaosRenamed)')" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(_KhaosPublishDir)$(KhaosGameName)$(_NativeExecutableExtension)"
             Condition="Exists('$(_KhaosPublishDir)$(KhaosGameName)$(_NativeExecutableExtension)')" />
  </Target>

  <PropertyGroup Label="Desktop" Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(UsingMicrosoftNETSdkWebAssembly)' != 'true' and '$(ApplicationIcon)' == ''">
    <ApplicationIcon>$(MSBuildThisFileDirectory)khaos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Label="Window icon" Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(UsingMicrosoftNETSdkWebAssembly)' != 'true' and '$(KhaosWindowIcon)' != ''">
    <EmbeddedResource Include="$(KhaosWindowIcon)" LogicalName="KappaDuck.Khaos.WindowIcon.png" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)KappaDuck.Khaos.WebAssembly.targets" Condition="'$(UsingMicrosoftNETSdkWebAssembly)' == 'true'" />
</Project>
