{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:KHAOS_HTTP_PORT",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}"
    },
    "Staging": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "?arg=--environment&arg=Staging",
      "applicationUrl": "http://localhost:KHAOS_HTTP_PORT",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}"
    },
    "Production": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "?arg=--environment&arg=Production",
      "applicationUrl": "http://localhost:KHAOS_HTTP_PORT",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}"
    }
  }
}
