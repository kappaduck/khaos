<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>KappaDuck.Khaos.Native</id>
    <version>1.1.0</version>
    <authors>KappaDuck</authors>
    <copyright>Copyright © KappaDuck</copyright>
    <description>SDL3, SDL_image, SDL_ttf and SDL_mixer for KappaDuck.Khaos: native libraries for Windows and Linux, and static WebAssembly libraries for the browser.</description>
    <tags>NET SDL SDL3 GameEngine Engine CSharp Game GameFramework Native WebAssembly Browser</tags>
    <repository type="git" url="https://github.com/kappaduck/khaos.git" />
    <projectUrl>https://github.com/kappaduck/khaos</projectUrl>
    <readme>readme.md</readme>
    <icon>icon.png</icon>
    <license type="file">license.txt</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="readme.md" target="" />
    <file src="../../license.txt" target="" />
    <file src="../../assets/nuget/icon.png" target="" />

    <file src="KappaDuck.Khaos.Native.props" target="buildTransitive/" />
    <file src="KappaDuck.Khaos.Native.targets" target="buildTransitive/" />

    <file src="runtimes/**/*" target="runtimes/" />
    <file src="licenses/**/*" target="licenses/" />

    <file src="wasm/**/*" target="wasm/" />
  </files>
</package>
