<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <KhaosNativeVersion>1.1.0</KhaosNativeVersion>
  </PropertyGroup>

  <ItemGroup Label="Global analyzers">
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <ItemGroup Label="Global build">
    <GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="PolySharp" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup Label="TypeScript">
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>

  <ItemGroup Label="Native">
    <PackageVersion Include="KappaDuck.Khaos.Native" Version="$(KhaosNativeVersion)" />
  </ItemGroup>

    <!--
    Roslyn: shared by the analyzer projects and tests/Khaos.Analyzers.Tests.
    Do not bump past the compiler shipped with the minimum supported SDK, otherwise the packaged
    analyzers fail to load for users (CS8032).
  -->
  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
</Project>
